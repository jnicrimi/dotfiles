[core]
  editor = nvim
  pager = delta
  quotepath = false

[init]
  defaultBranch = main

[commit]
  verbose = true

[status]
  showUntrackedFiles = all

[fetch]
  prune = true

[pull]
  rebase = false

[push]
  default = nothing

[rebase]
  autoStash = true
  updateRefs = true

[merge]
  conflictStyle = zdiff3
  tool = nvimdiff

[rerere]
  enabled = true

[diff]
  algorithm = histogram
  colorMoved = default
  colorMovedWS = allow-indentation-change

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true
  side-by-side = true
  syntax-theme = Catppuccin Mocha

[ghq]
  root = ~/ghq

[include]
  path = ~/.gitconfig.local
